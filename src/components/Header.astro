---
interface Link {
  name: string;
  href: string;
}

const links = [
  { name: 'home', href: '/' },
  { name: 'blog', href: '/blog' },
] satisfies Link[];
---

<header class="flex justify-between">
  <h1 class="font-bold after:-mt-1.5 after:block after:content-['=======']">baxthus</h1>
  <div class="flex h-fit">
    {links.map((link, index) => (
      <>
        <a href={link.href} class="font-bold">{link.name}</a>
        {index !== links.length - 1 && <span class="mx-2 font-bold">|</span>}
      </>
    ))}
  </div>
</header>
