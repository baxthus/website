---
// biome-ignore lint/correctness/noUnusedImports: used by the Astro template
import { bannerArt } from '@/lib/banner';
---

<div class="ascii-background" aria-hidden="true">
  <pre class="ascii-background__dither" data-ascii-dither></pre>
  <pre class="ascii-background__illustration">{bannerArt}</pre>
  <pre class="ascii-background__noise" data-ascii-noise></pre>
</div>

<script>
const bayerMatrix = [
  [0, 8, 2, 10],
  [12, 4, 14, 6],
  [3, 11, 1, 9],
  [15, 7, 13, 5],
];
const ditherRamp = '  ..::++##';
const noiseRamp = ".'`*";

const hash = (x, y, seed = 0) => {
  const value = Math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453;
  return value - Math.floor(value);
};

const measureCharacterCell = (element) => {
  const styles = getComputedStyle(element);
  const probe = document.createElement('span');
  probe.textContent = '0000000000';
  Object.assign(probe.style, {
    position: 'fixed',
    visibility: 'hidden',
    fontFamily: styles.fontFamily,
    fontSize: styles.fontSize,
    fontWeight: styles.fontWeight,
    letterSpacing: styles.letterSpacing,
    whiteSpace: 'pre',
  });
  document.body.append(probe);

  const width = probe.getBoundingClientRect().width / probe.textContent.length;
  const height = Number.parseFloat(styles.lineHeight);
  probe.remove();

  return { width, height };
};

const buildLayers = (columns, rows) => {
  const dither = [];
  const noise = [];

  for (let row = 0; row < rows; row += 1) {
    let ditherLine = '';
    let noiseLine = '';

    for (let column = 0; column < columns; column += 1) {
      const x = (column / Math.max(columns - 1, 1)) * 2 - 1;
      const y = (row / Math.max(rows - 1, 1)) * 2 - 1;
      const distance = Math.hypot(x * 0.72, y * 0.9);
      const haze = Math.max(0, 1 - distance);
      const wave = (Math.sin(x * 8 + y * 5) + Math.cos(y * 11 - x * 3)) * 0.025;
      const tone = Math.max(0, Math.min(0.68, haze * 0.52 + wave));
      const scaledTone = tone * (ditherRamp.length - 1);
      const lowerStep = Math.floor(scaledTone);
      const threshold = (bayerMatrix[row % 4][column % 4] + 0.5) / 16;
      const rampIndex = Math.min(
        ditherRamp.length - 1,
        lowerStep + (scaledTone - lowerStep > threshold ? 1 : 0),
      );

      ditherLine += ditherRamp[rampIndex];

      const noiseValue = hash(column, row, 3);
      noiseLine +=
        noiseValue > 0.982 ? noiseRamp[Math.floor(hash(column, row, 9) * noiseRamp.length)] : ' ';
    }

    dither.push(ditherLine);
    noise.push(noiseLine);
  }

  return { dither: dither.join('\n'), noise: noise.join('\n') };
};

let resizeFrame = 0;

const renderAsciiBackground = () => {
  cancelAnimationFrame(resizeFrame);
  resizeFrame = requestAnimationFrame(() => {
    const ditherElement = document.querySelector('[data-ascii-dither]');
    const noiseElement = document.querySelector('[data-ascii-noise]');

    if (!(ditherElement instanceof HTMLElement) || !(noiseElement instanceof HTMLElement)) return;

    const cell = measureCharacterCell(ditherElement);
    const columns = Math.min(400, Math.ceil((window.innerWidth + 20) / cell.width) + 1);
    const rows = Math.min(180, Math.ceil((window.innerHeight + 20) / cell.height) + 1);
    const layers = buildLayers(columns, rows);

    ditherElement.textContent = layers.dither;
    noiseElement.textContent = layers.noise;
  });
};

renderAsciiBackground();
window.addEventListener('resize', renderAsciiBackground, { passive: true });
document.addEventListener('astro:page-load', renderAsciiBackground);
document.fonts.ready.then(renderAsciiBackground);
</script>

<style>
.ascii-background {
  position: fixed;
  z-index: 0;
  inset: 0;
  overflow: hidden;
  color: rgb(0 0 0 / 10%);
  pointer-events: none;
  user-select: none;
}

.ascii-background pre {
  position: absolute;
  margin: 0;
  font-family: var(--font-mono);
  font-variant-ligatures: none;
  white-space: pre;
}

.ascii-background__dither,
.ascii-background__noise {
  inset: -10px;
  font-size: 10px;
  line-height: 10px;
  letter-spacing: 0;
}

.ascii-background__dither {
  opacity: 0.78;
}

.ascii-background__illustration {
  top: 50%;
  left: 50%;
  opacity: 0.72;
  font-size: clamp(7px, 0.8vw, 10px);
  line-height: 1;
  transform: translate(-50%, -50%) scale(1.1);
  transform-origin: center;
}

.ascii-background__noise {
  opacity: 0.7;
}

@media (prefers-color-scheme: dark) {
  .ascii-background {
    color: rgb(255 255 255 / 11%);
  }
}

@media (max-width: 40rem) {
  .ascii-background__illustration {
    font-size: 9px;
    transform: translate(-50%, -50%) scale(1.15);
  }
}
</style>
